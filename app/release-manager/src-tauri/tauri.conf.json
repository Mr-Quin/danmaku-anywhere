{
  "productName": "Release Manager",
  "version": "0.5.0",
  "identifier": "fish.quin.danmaku-anywhere.release-manager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm vite",
    "beforeBuildCommand": "pnpm vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Release Manager",
        "width": 1024,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5MzNDODlGQTE2QjAyMjAKUldRZ0FtdWhuOGd6eVZpMGpzUCsyZ05WK1I2dXlXaXh5V1h4a2dMVE4xc1A2Ujc4OVVDZGtzWlYK",
      "endpoints": [
        "https://github.com/Danmaku-Anywhere/release-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
