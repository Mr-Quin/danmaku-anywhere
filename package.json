{
  "name": "danmaku-anywhere",
  "version": "0.0.1",
  "private": true,
  "author": "Mr-Quin",
  "description": "Danmaku anywhere",
  "type": "module",
  "keywords": [
    "plex",
    "danmaku",
    "user script"
  ],
  "repository": "https://github.com/Danmaku-Anywhere/danmaku-anywhere",
  "scripts": {
    "dev:extension": "pnpm -r -F \"./packages/danmaku-anywhere\" dev",
    "dev:extension:standalone": "pnpm -r -F \"./packages/danmaku-anywhere\" standalone:dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm -r -F \"./packages/**\" build",
    "format": "pnpm -r -F \"./packages/**\" format",
    "lint": "pnpm -r -F \"./packages/**\" lint",
    "lint:ci": "pnpm -r lint:ci",
    "test": "pnpm -r test",
    "type-check": "pnpm -r type-check",
    "knip": "knip",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@changesets/cli": "^3.0.3",
    "@typescript/native-preview": "7.0.0-dev.20260521.1",
    "knip": "6.41.0",
    "lefthook": "^2.2.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.2.2"
}
