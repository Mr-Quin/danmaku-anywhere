{
  "name": "@danmaku-anywhere/proxy",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "author": "Mr-Quin",
  "repository": "https://github.com/Mr-Quin/danmaku-anywhere",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "dev": "wrangler dev",
    "dev:remote": "pnpm dev --remote",
    "test": "vitest run",
    "lint": "biome check --fix",
    "lint:ci": "biome ci",
    "type-check": "tsgo --noEmit",
    "cf-typegen": "wrangler types",
    "wrangler": "wrangler",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy --env production",
    "drizzle": "drizzle-kit",
    "drizzle:generate": "drizzle-kit generate --config drizzle.config.ts",
    "drizzle:push:prod": "drizzle-kit push --config drizzle.config.ts",
    "better-auth:generate": "pnpx @better-auth/cli@latest generate",
    "db:migrate:local": "pnpm wrangler d1 migrations apply danmaku-anywhere-db-staging --env staging --local",
    "db:migrate:staging": "pnpm wrangler d1 migrations apply danmaku-anywhere-db-staging --env staging",
    "db:migrate:prod": "pnpm wrangler d1 migrations apply danmaku-anywhere-db --env production"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@cloudflare/vitest-pool-workers": "^0.13.5",
    "@types/node": "^24.19.2",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "4.1.0",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@danmaku-anywhere/integration-policy": "workspace:*",
    "@google/generative-ai": "^0.24.1",
    "@hono/standard-validator": "^0.2.3",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.7.6",
    "@scalar/hono-api-reference": "^0.9.48",
    "@sentry/cloudflare": "^10.76.2",
    "better-auth": "^1.6.33",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "hono-openapi": "^1.3.5",
    "resend": "^6.32.1",
    "zod": "^4.6.5"
  }
}
