{
  "name": "@danmaku-anywhere/web-scraper",
  "version": "0.2.0",
  "description": "Scrape websites from browser extension context",
  "author": "Mr-Quin",
  "repository": {
    "type": "git",
    "url": "https://github.com/Danmaku-Anywhere/danmaku-anywhere",
    "directory": "packages/web-scraper"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsgo",
    "lint": "biome check --fix",
    "test": "vitest run",
    "type-check": "tsgo --noEmit"
  },
  "dependencies": {
    "@danmaku-anywhere/danmaku-converter": "workspace:^",
    "@danmaku-anywhere/danmaku-provider": "workspace:^",
    "async-mutex": "^0.5.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@types/chrome": "^0.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "vitest": "^5.0.3"
  }
}
