{
  "name": "@danmaku-anywhere/extension-protocol",
  "version": "0.1.0",
  "description": "Messages exchanged between the Danmaku Anywhere extension and the pages it talks to",
  "author": "Mr-Quin",
  "repository": {
    "type": "git",
    "url": "https://github.com/Danmaku-Anywhere/danmaku-anywhere",
    "directory": "packages/extension-protocol"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true,
    "main": "dist/src/index.js",
    "types": "dist/src/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsgo",
    "lint": "biome check --fix",
    "type-check": "tsgo --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@danmaku-anywhere/danmaku-model": "workspace:^"
  },
  "peerDependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
